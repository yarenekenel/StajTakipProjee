@model List<StajTakipp.WebUI.Models.MentorViewModel>
@{
    var kurumlar = ViewBag.Kurumlar as List<StajTakipp.WebUI.Models.KurumViewModel>;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Mentörler</h2>
    <a asp-action="Ekle" class="btn btn-primary">+ Yeni Mentör Ekle</a>
</div>

@if (TempData["SilmeHatasi"] != null)
{
    <div class="alert alert-danger">@TempData["SilmeHatasi"]</div>
}

<!-- Arama ve Filtreler -->
<div class="card mb-3 no-print">
    <div class="card-body">
        <div class="row g-2">
            <div class="col-md-4">
                <input type="text" id="filtreAdSoyad" class="form-control" placeholder="Ad Soyad ile ara..." />
            </div>
            <div class="col-md-3">
                <select id="filtreUnvan" class="form-select">
                    <option value="">-- Tüm Unvanlar --</option>
                </select>
            </div>
            <div class="col-md-3">
                <select id="filtreKurum" class="form-select">
                    <option value="">-- Tüm Kurumlar --</option>
                    @if (kurumlar != null)
                    {
                        foreach (var k in kurumlar)
                        {
                            <option value="@k.KurumAdi">@k.KurumAdi</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-2">
                <button id="filtreTemizle" class="btn btn-outline-secondary w-100" title="Filtreleri Temizle">Temizle</button>
            </div>
        </div>
    </div>
</div>

<div class="d-flex justify-content-end gap-2 mb-2 no-print">
    <button onclick="window.print()" class="btn btn-outline-dark btn-sm">🖨️ Yazdır / PDF</button>
    <button onclick="excelAktar()" class="btn btn-outline-success btn-sm">📊 Excel'e Aktar</button>
</div>

<div class="card shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" id="mentorTablosu">
                <thead class="table-light">
                    <tr>
                        <th>Ad</th>
                        <th>Soyad</th>
                        <th>Unvan</th>
                        <th>Kurum</th>
                        <th class="text-end no-print">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var mentor in Model)
                    {
                        var adSoyad = $"{mentor.Ad} {mentor.Soyad}";
                        var kurum = kurumlar?.FirstOrDefault(k => k.Id == mentor.KurumId);
                        <tr data-adsoyad="@adSoyad.ToLower()" data-unvan="@(mentor.Unvan ?? "")" data-kurum="@(kurum?.KurumAdi ?? "")">
                            <td>@mentor.Ad</td>
                            <td>@mentor.Soyad</td>
                            <td>
                                @if (!string.IsNullOrEmpty(mentor.Unvan))
                                {
                                    <span class="badge bg-success">@mentor.Unvan</span>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>
                            <td>
                                @if (kurum != null)
                                {
                                    <span class="badge bg-primary">@kurum.KurumAdi</span>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>
                            <td class="text-end no-print">
                                <a href="#" onclick="mentorSil('@Url.Action("Sil", "Mentor", new { id = mentor.Id })'); return false;" class="btn btn-sm btn-outline-danger">Sil</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<p class="text-muted mt-2 no-print" id="sonucSayisi"></p>

@section Scripts {
    <style>
        @@media print {
            .no-print {
                display: none !important;
            }

            header, nav, footer {
                display: none !important;
            }

            .container {
                max-width: 100% !important;
            }

            .card.shadow-sm {
                border: none !important;
                box-shadow: none !important;
            }

            h2 {
                margin-bottom: 10px;
            }

            table {
                font-size: 12px;
            }

            .badge {
                color: #000 !important;
                background: none !important;
                border: 1px solid #999;
            }
        }
    </style>
    <script>
        function mentorSil(url) {
            Swal.fire({
                title: 'Emin misiniz?',
                text: 'Bu mentörü silmek istediğinize emin misiniz?',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Evet, sil',
                cancelButtonText: 'Vazgeç',
                confirmButtonColor: '#d33'
            }).then((result) => {
                if (result.isConfirmed) {
                    window.location.href = url;
                }
            });
        }

        // Unvan dropdown'unu tablo verisinden dinamik doldur
        (function unvanDropdownDoldur() {
            const select = document.getElementById('filtreUnvan');
            const unvanlar = new Set();
            document.querySelectorAll('#mentorTablosu tbody tr').forEach(satir => {
                if (satir.dataset.unvan) unvanlar.add(satir.dataset.unvan);
            });
            [...unvanlar].sort().forEach(unvan => {
                const opt = document.createElement('option');
                opt.value = unvan;
                opt.textContent = unvan;
                select.appendChild(opt);
            });
        })();

        function filtrele() {
            const adSoyad = document.getElementById('filtreAdSoyad').value.toLowerCase();
            const unvan = document.getElementById('filtreUnvan').value;
            const kurum = document.getElementById('filtreKurum').value;

            const satirlar = document.querySelectorAll('#mentorTablosu tbody tr');
            let gorunenSayi = 0;

            satirlar.forEach(satir => {
                const satirAdSoyad = satir.dataset.adsoyad || '';
                const satirUnvan = satir.dataset.unvan || '';
                const satirKurum = satir.dataset.kurum || '';

                const adSoyadUyuyor = satirAdSoyad.includes(adSoyad);
                const unvanUyuyor = unvan === '' || satirUnvan === unvan;
                const kurumUyuyor = kurum === '' || satirKurum === kurum;

                if (adSoyadUyuyor && unvanUyuyor && kurumUyuyor) {
                    satir.style.display = '';
                    gorunenSayi++;
                } else {
                    satir.style.display = 'none';
                }
            });

            document.getElementById('sonucSayisi').innerText = gorunenSayi + ' kayıt gösteriliyor.';
        }

        document.getElementById('filtreAdSoyad').addEventListener('input', filtrele);
        document.getElementById('filtreUnvan').addEventListener('change', filtrele);
        document.getElementById('filtreKurum').addEventListener('change', filtrele);
        document.getElementById('filtreTemizle').addEventListener('click', function () {
            document.getElementById('filtreAdSoyad').value = '';
            document.getElementById('filtreUnvan').value = '';
            document.getElementById('filtreKurum').value = '';
            filtrele();
        });

        function excelAktar() {
            const basliklar = ["Ad", "Soyad", "Unvan", "Kurum"];
            const veriler = [basliklar];

            const satirlar = document.querySelectorAll('#mentorTablosu tbody tr');
            satirlar.forEach(satir => {
                if (satir.style.display === 'none') return;

                const hucreler = satir.querySelectorAll('td');
                const satirVerisi = [];
                for (let i = 0; i < 4; i++) {
                    satirVerisi.push(hucreler[i] ? hucreler[i].innerText.trim() : "");
                }
                veriler.push(satirVerisi);
            });

            const ws = XLSX.utils.aoa_to_sheet(veriler);
            ws['!cols'] = [{ wch: 16 }, { wch: 16 }, { wch: 18 }, { wch: 22 }];

            const wb = XLSX.utils.book_new();
            XLSX.utils.book_append_sheet(wb, ws, "Mentörler");
            XLSX.writeFile(wb, "MentorListesi.xlsx");
        }

        @if (TempData["BasariMesaji"] != null)
        {
                    <text>
                    Swal.fire({
                        title: 'Başarılı!',
                        text: '@TempData["BasariMesaji"]',
                        icon: 'success',
                        confirmButtonText: 'Tamam'
                    });
                    </text>
        }

        filtrele();
    </script>
}